+/* Wide tables keep their horizontal bar painted instead of revealing it on
+   hover (or keyboard focus). Chromium never repaints state-conditioned
    scrollbar STYLES (neither hover-conditioned `::-webkit-scrollbar*` rules
-   nor a :hover `scrollbar-color` change reaches the painted bar), so the
-   toggle is `overflow-x` itself — a layout change repaints reliably. The
-   resting padding matches the themed bar's height on the WebKit scrollbar
-   path. There, `scroll` reserves that height even when the table fits.
-   Other engines and overlay scrollbars may reserve a different height.
-   Wheel and trackpad scrolling need the pointer over the table, which is
-   already the hover that re-enables scrolling. */
-.tableScroll:global(.md-table-wide) {
-  overflow-x: hidden;
-  padding-bottom: var(--dsh-scrollbar-width, 5px);
-}
-
-.tableScroll:global(.md-table-wide):hover,
-.tableScroll:global(.md-table-wide):focus-visible {
-  overflow-x: scroll;
-  padding-bottom: 0;
+   nor a :hover `scrollbar-color` change reaches the painted bar), so there
+   is no `overflow-x` toggle left to flip: the wide modifier drops its
+   `hidden` override and inherits the base rule's `auto`, while
+   `scrollbar-width` and `scrollbar-color` now sit on `.tableScroll` itself.
+   The WebKit bar geometry below completes the theme. Wheel and trackpad
+   scrolling need no hover gate either. */
+.tableScroll:global(.md-table-wide)::-webkit-scrollbar {
+  height: 8px;
+}
+
+.tableScroll:global(.md-table-wide)::-webkit-scrollbar-track {
+  background: transparent;
+}
+
+.tableScroll:global(.md-table-wide)::-webkit-scrollbar-thumb {
+  border-radius: 4px;
+  background: var(--dsw-alias-label-tertiary, #9098a3);
+}
+
+.tableScroll:global(.md-table-wide)::-webkit-scrollbar-thumb:hover {
+  background: var(--dsw-alias-label-secondary, #c9ced8);
 }
 
