.DS_Store
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
node_modules/
*.tsbuildinfo
.build/

dsh-plugin-desktop-beta/dist/
/dist/
dsh-plugin-desktop-beta/lib/
dsh-community-market/lib/

.env.yarn

nonead-dsh-desktop/lib/
nonead-dsh-desktop/dist/
# Cross-arch builds write a separate output directory (`DSH_PACKAGE_OUTPUT_DIR=dist-arm64`).
nonead-dsh-desktop/dist-*/
dsh-plugin-desktop-beta/dist-*/
nonead-dsh-desktop/.nonead-dsh-desktop/
nonead-dsh-desktop/.desktop-build/
dsh-plugin-desktop-beta/.desktop-build/

# Local scratch directories and runtime logs: not product source.
.tmp-investigate/
.tmp_*
/.tmp-*/
.pnpm-store/
GitLab.lnk
debug.log

# Local Agents Anywhere source staging for aa:prepare-release (DSH_AA_SOURCE_DIR).
/Agents-Anywhere/

# Local checkouts of sibling repositories. Neither is a workspace member, and
# nothing in this repository references them.
dsh-market/
dsh-nonead-universal-robots/

# Superseded runtime snapshots. upstream.json and yarn.lock reference only
# vendor/dsh-runtime/0.2.0-rc.2 (stable) and vendor/dsh-runtime/0.2.1-rc.2
# (beta).
vendor/dsh-runtime/0.1.5-rc.2/
vendor/dsh-runtime/0.1.7-alpha.2/
vendor/dsh-runtime/0.1.7-rc.1/
vendor/dsh-runtime/0.1.7-rc.2/
vendor/dsh-runtime/0.2.0-rc.1/
vendor/dsh-runtime/0.2.1-alpha.1/
vendor/dsh-runtime/0.2.1-alpha.2/
vendor/dsh-runtime/0.2.1-alpha.3/
vendor/dsh-runtime/0.2.1-alpha.4/
vendor/dsh-runtime/0.2.1-alpha.5/
vendor/dsh-runtime/0.2.1-rc.1/
vendor/dsh-runtime/0.2.1-rc.2/
vendor/dsh-runtime/0.2.1-rc.3/

# Patches authored for superseded runtime versions. The consumed sets are
# 0.2.0-rc.2 and 0.2.1-rc.2.
patches/*@0.1.5-rc.2.patch
patches/*@0.1.7-alpha.2.patch
patches/*@0.1.7-rc.1.patch
patches/*@0.1.7-rc.2.patch
patches/*@0.2.0-rc.1.patch
patches/*@0.2.1-alpha.1.patch
patches/*@0.2.1-alpha.2.patch
patches/*@0.2.1-alpha.3.patch
patches/*@0.2.1-alpha.4.patch
patches/*@0.2.1-alpha.5.patch
patches/*@0.2.1-rc.1.patch
patches/*@0.2.1-rc.2.patch

# Superseded dshmarket patches; the consumed one is dshmarket-desktop.patch.
.yarn/patches/dshmarket-npm-*.patch

# Agents Anywhere artifacts accumulate one file per release build; only the
# bridge referenced by package.json and yarn.lock is consumed. Every tgz kept in
# the tree must also be negated below, otherwise a re-add silently drops it.
vendor/agents-anywhere/*.tgz
!vendor/agents-anywhere/agents-anywhere-dsh-bridge-next-2.1.0-desktop.c39b82d4fffb1.r7504932a.tgz
!vendor/agents-anywhere/agents-anywhere-dsh-bridge-next-2.1.0-desktop.c39b82d4fffb1.rd9c47cbc.tgz
!vendor/agents-anywhere/agents-anywhere-dsh-bridge-next-2.1.0-desktop.c39b82d4fffb1.rbcb63731.tgz
!vendor/agents-anywhere/agents-anywhere-dsh-bridge-next-2.1.0-desktop.c39b82d4fffb1.rc2b11bfc.tgz
!vendor/agents-anywhere/agents-anywhere-dsh-bridge-next-2.1.0-desktop.ce8f0cb9e1d9a.rc2b11bfc.tgz
!vendor/agents-anywhere/agents-anywhere-dsh-bridge-next-2.1.0-desktop.ce8f0cb9e1d9a.r33fd0a0e.tgz

# Local-only scratch that must never enter the repository: copied Profile data
# (may carry credentials), build caches, and inspection output.
/temp/
/.corepack-home/
/.pnpm-home/
/.market-upgrade-backup/
/.aa-inspect/
/.plugin-fetch/
# Relocated Yarn cache (YARN_GLOBAL_FOLDER) for hosts that cannot write outside the checkout.
/.yarn-global/

# Plugin archives ARE tracked: the corp repository is the distribution source for
# the preinstalled plugins, so plugin/*.tgz travels with plugin/manifest.json
# instead of being regenerated locally by the wizard.

# Build logs and package-manager cache.
/.nsis-build/*.log
/.yarn/install-state.gz

# Scratch left by npm pack and a superseded market checkout.
/package/
/dshmarket-1.73.6/
